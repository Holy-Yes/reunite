# Optional. Copy to .env.local and restart `npm run dev`.

# Photorealistic 3D buildings on the campus map (Google Map Tiles API key with billing enabled).
# Without it the map shows satellite imagery with extruded OpenStreetMap footprints.
VITE_GOOGLE_MAPS_API_KEY=

# Alternative: a free Cesium ion token adds world terrain and Cesium OSM Buildings.
VITE_CESIUM_ION_TOKEN=
