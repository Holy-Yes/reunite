# Production environment for docker-compose.yml. Copy to .env.production and fill in real values:
#
#   cp .env.production.example .env.production
#
# This is separate from the dev .env.example / .env at the repo root -- those are for running the
# app directly on a laptop without Docker, and other sessions in this shared repo may depend on them.
# NEVER reuse the dev .env's JWT_SECRET or DATABASE_URL here. Generate fresh ones:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Postgres (read by both the postgres service and the backend's DATABASE_URL below -- keep them in sync) ---
POSTGRES_USER=reunite
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=reunite
DATABASE_URL=postgresql+psycopg://reunite:change-me-to-a-long-random-password@postgres:5432/reunite

# --- Required: rotate this, never reuse the dev .env's value ---
JWT_SECRET=change-me-to-a-long-random-string

# --- The real public origin of the deployed frontend, e.g. https://reunite.example.edu ---
CORS_ORIGINS=https://reunite.example.edu

# --- Bootstrap: these addresses get the given role on first sign-in (comma-separated) ---
ADMIN_EMAILS=
DESK_EMAILS=
SECURITY_GUARD_EMAILS=

ALLOWED_EMAIL_DOMAINS=
MEDIA_DIR=data/media
DEVICE=auto
ML_MODE=full
NOTIFY_THRESHOLD=0.60
BAND_STRONG=0.75
BAND_POSSIBLE=0.40
MIN_SHOW=0.20
ALWAYS_REVIEW=laptop,phone,id_card
ROLL_NO_REGEX=\d{2}07[15]A[0-9A-Z]{4}
RETENTION_DAYS=90
UNCLAIMED_ROUTE_DAYS=30
UNCLAIMED_ROUTE_ZONE=z_gate
UNCLAIMED_ROUTE_LABEL=the campus security desk
CAMPUS_NAME=<<CAMPUS_NAME>>

# --- Real email delivery (leave EMAIL_BACKEND=console to keep OTP codes in `docker compose logs backend`) ---
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Demo only: every sign-in code becomes this value and the sign-in page displays it.
# Leave EMPTY in production -- this bypasses OTP verification entirely.
DEMO_OTP=
