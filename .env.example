# Copy to .env and edit. See docs/IMPLEMENTATION_PLAN.md section 16.
DATABASE_URL=postgresql+psycopg://localhost/reunite
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_EMAIL_DOMAINS=
CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190
MEDIA_DIR=data/media
DEVICE=auto
ML_MODE=full            # full = real models, light = tiny deterministic stand-ins (tests, CI)
NOTIFY_THRESHOLD=0.60
BAND_STRONG=0.75
BAND_POSSIBLE=0.40
MIN_SHOW=0.20
ALWAYS_REVIEW=laptop,phone,id_card
ROLL_NO_REGEX=\d{2}07[15]A[0-9A-Z]{4}
RETENTION_DAYS=90
UNCLAIMED_ROUTE_DAYS=30            # 0 disables routing of unclaimed found items
UNCLAIMED_ROUTE_ZONE=z_gate
UNCLAIMED_ROUTE_LABEL=the campus security desk
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
CAMPUS_NAME=<<CAMPUS_NAME>>
# Bootstrap: these addresses get the given role on first sign-in (comma-separated, case-insensitive)
ADMIN_EMAILS=
DESK_EMAILS=
SECURITY_GUARD_EMAILS=
# Front-end variable (use the template's public prefix, e.g. VITE_):
# VITE_CESIUM_ION_TOKEN=<<CESIUM_ION_TOKEN>>
# Demo only: every sign-in code becomes this value and the sign-in page displays it. Leave empty in production.
DEMO_OTP=
